<UserControl x:Class="VECTOTrailer.Views.ComponentViews.Declaration.CompleteTrailerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VECTOTrailer.Views.ComponentViews.Declaration"
             xmlns:interfaces="clr-namespace:VECTOTrailer.ViewModel.Interfaces"
             xmlns:customControls="clr-namespace:VECTOTrailer.Views.CustomControls"
             xmlns:helper="clr-namespace:VECTOTrailer.Helper"
             xmlns:converter="clr-namespace:VECTOTrailer.Helper.Converter"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:validation="clr-namespace:VECTOTrailer.Helper.Validation"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1210">

    <d:CompleteTrailerViewModel.DataContext>
        <x:Type Type="interfaces:ICompleteTrailerViewModel" />
    </d:CompleteTrailerViewModel.DataContext>

    <UserControl.Resources >
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--Width="400" Height="200"-->
        <GroupBox Header="Documentation" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True" VerticalAlignment="Stretch">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Manufacturer" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" TextWrapping="Wrap"
                                 Text="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Manufacturer Address" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" TextWrapping="Wrap"
                                 Text="{Binding ManufacturerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Model / CommercialName" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" TextWrapping="Wrap"
                                 Text="{Binding TrailerModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VIN" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding VIN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <!--<Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Date" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>-->


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Legislative Category" Margin="0,0,10,0"/>
                        <customControls:DefaultTextComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedLegislativeCategory}"
                                  SelectedValue="{Binding LegislativeCategory, Mode=TwoWay ,ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  DefaultText="Select..."/>
                    </Grid>

                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!--Width="400" Height="350"-->
        <GroupBox Header="Dimensions" Grid.Row="2" Grid.Column="1"  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True" VerticalAlignment="Stretch">
                <!--<StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">-->

                <Grid>
                    <customControls:VectoParameterControl
                            Caption="External length of the body" CaptionWidthGroup="lblGWidth"
                            Value="{Binding ExternalLengthOfTheBody, 
                                Converter={converter:SIValueConverter},
                                ConverterParameter=AsMeter|double3, UpdateSourceTrigger=LostFocus, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m" UnitWidthGroup="unitWidth"/>
                </Grid>

                <Grid>
                    <customControls:VectoParameterControl
                            Caption="External width of the body" CaptionWidthGroup="lblGWidth"
                            Value="{Binding ExternalWidthOfTheBody, Converter={converter:SIValueConverter}, 
                            ConverterParameter=AsMeter|double3, UpdateSourceTrigger=LostFocus, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m" UnitWidthGroup="unitWidth"/>
                </Grid>

                <Grid>
                    <customControls:VectoParameterControl
                            Caption="External height of the body" CaptionWidthGroup="lblGWidth"
                            Value="{Binding ExternalHeightOfTheBody, 
                                Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsMeter|double3, UpdateSourceTrigger=LostFocus, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m" UnitWidthGroup="unitWidth"/>
                </Grid>

                <Grid>
                    <customControls:VectoParameterControl
                            Caption="Total height of the trailer" CaptionWidthGroup="lblGWidth"
                            Value="{Binding TotalHeightOfTheTrailer, 
                                Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsMeter|double3, UpdateSourceTrigger=LostFocus, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m" UnitWidthGroup="unitWidth"/>
                </Grid>

                <Grid>
                    <customControls:VectoParameterControl
                            Caption="Length from trailer front end to centre of first axle" CaptionWidthGroup="lblGWidth"
                            Value="{Binding LengthFromFrontToFirstAxle, 
                                Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsMeter|double3, 
                                
                                UpdateSourceTrigger=LostFocus, 
                                NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m" UnitWidthGroup="unitWidth"/>
                </Grid>


                <Grid>
                    <customControls:VectoParameterControl
                            Caption="Length between centres of axles" CaptionWidthGroup="lblGWidth"
                            Value="{Binding LengthBetweenCentersOfAxles, 
                                Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsMeter|double3, 
                                UpdateSourceTrigger=LostFocus, 
                                NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m" UnitWidthGroup="unitWidth" Visibility="{Binding ShowLengthBetweenCentersOfAxles,
                                Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>


                <Grid>
                    <customControls:VectoParameterControl
                            Caption="Cargo volume" CaptionWidthGroup="lblGWidth"
                            Value="{Binding CargoVolume, 
                                Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsCubicMeter|double3, 
                                UpdateSourceTrigger=LostFocus, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="m3" UnitWidthGroup="unitWidth"/>
                </Grid>

                <!--</StackPanel>-->
            </StackPanel>
        </GroupBox>
        <!--Width="330" Height="200"-->
        <GroupBox Header="Classification" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Number of Axles" Margin="0,0,10,0"/>
                        <customControls:DefaultTextComboBox x:Name="NumberOfAxles"  Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedNumberOfAxles}"
                                  
                                  SelectedValue="{Binding NumberOfAxles, 
                                        Mode=TwoWay ,
                                        ValidatesOnDataErrors=True, 
                                        NotifyOnValidationError=True, 
                                        UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="False"
                                  DefaultText="Select..."
                                  />
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Trailer Type" Margin="0,0,10,0"/>
                        <customControls:DefaultTextComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedTrailerTypes}"
                                  SelectedValue="{Binding TrailerType, 
                                    Mode=TwoWay ,ValidatesOnDataErrors=True, 
                                    NotifyOnValidationError=True, 
                                    UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  DefaultText="Select..."/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Trailer Coupling Point" Margin="0,0,10,0" Visibility="{Binding ShowTrailerCouplingPoint, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Grid Grid.Column="1">
                            <customControls:DefaultTextComboBox
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedTrailerCouplingPoint}"
                                  SelectedValue="{Binding TrailerCouplingPoint, Mode=TwoWay ,ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  DefaultText="Select..."
                                  Visibility="{Binding ShowTrailerCouplingPoint, Converter={StaticResource BoolToVisibilityConverter}}">
                            </customControls:DefaultTextComboBox>
                        </Grid>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Bodywork Type" Margin="0,0,10,0"/>
                        <customControls:DefaultTextComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedBodyCodes}"
                                  SelectedValue="{Binding BodyCode, Mode=TwoWay, ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  DefaultText="Select..."/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Grid.Column="0" Text="Volume Orientation" Margin="0,0,0,0"/>
                            <TextBlock Grid.Column="0" Text="(see Annex I, point 1(6))" Margin="0,0,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding VolumeOrientation}" Margin="20,0,7.5,0" Height="15" HorizontalAlignment="Right"/>

                    </Grid>


                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!--Width="330" Height="350"-->
        <GroupBox Header="Αero feature technologies" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <StackPanel Orientation="Vertical"  HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">

                    <RadioButton Margin="0,5,0,0" GroupName="features" Name="standard" IsChecked="{Binding IsStandard}" HorizontalAlignment="Left">Standard aerodynamic devices</RadioButton>
                    <RadioButton Margin="0,5,0,0" GroupName="features" Name="certified" IsChecked="{Binding IsCertified}" HorizontalAlignment="Left">Certified aerodynamic device</RadioButton>
                    <RadioButton Margin="0,5,0,0" GroupName="features" Name="none" IsChecked="{Binding IsNone}" HorizontalAlignment="Left">None</RadioButton>

                    <GroupBox Header="Side covers"  Visibility="{Binding IsChecked,ElementName=standard,Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Short side covers"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding SideSkirtsShort}"/>
                            <TextBlock Grid.Column="3" Text="Long side covers"/>
                            <CheckBox Grid.Column="4" IsChecked="{Binding SideSkirtsLong}"/>

                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Rear flaps" Visibility="{Binding IsChecked,ElementName=standard,Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="5" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Short rear flaps" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding BoatTailShort}"/>

                            <TextBlock Grid.Column="3" Text="Tall rear flaps"/>
                            <CheckBox Grid.Column="4" IsChecked="{Binding BoatTailLong}"/>

                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Certified aerodynamic device XML" Margin="5" HorizontalAlignment="Stretch" Visibility="{Binding IsChecked,ElementName=certified,Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel HorizontalAlignment="Stretch" Margin="5" LastChildFill="True" >
                            <Button DockPanel.Dock="Right" Name="UploadCertifiedAeroDeviceButton" Grid.Column="3" Content="..." Width="30" Margin="5,0,0,0"
                                    Command="{Binding SelectCertifiedAeroDeviceCommand}"
                                    CommandParameter="{Binding CertifiedAeroDeviceType}" />
                            <StackPanel Orientation="Vertical">
                                <!--<TextBlock Margin="5" Text="{Binding AeroDeviceInfo, TargetNullValue='Select aerodevice xml'}"></TextBlock>-->
                                <TextBox DockPanel.Dock="Left" HorizontalAlignment="Stretch" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" TextChanged="ScrollToEnd"
                                         Text="{Binding CertifiedAeroDeviceFilePath}"><!--Visibility="{Binding CertifiedAeroDeviceFilePath, Converter={converter:NullToVisibilityConverter}}">-->
                                    <Validation.ErrorTemplate>
                                        <ControlTemplate>
                                            <DockPanel>
                                                <TextBlock Foreground="Red" DockPanel.Dock="Top" Text="{Binding ErrorContent}" />
                                                <AdornedElementPlaceholder/>
                                            </DockPanel>
                                        </ControlTemplate>
                                    </Validation.ErrorTemplate>
                                    <TextBox.Style>
                                        <Style>
                                            <Style.Triggers>
                                                <Trigger Property="Validation.HasError" Value="true">
                                                    <Setter Property="Border.BorderBrush" Value="Red"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </StackPanel>
                        </DockPanel>
                    </GroupBox>


                    <!--<StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                        <TextBlock Text="CdXA reduction"/>
                            <Grid>
                            <customControls:VectoParameterControl
                                Caption="Yaw angle 0" CaptionWidthGroup="lblGWidth"
                                Value="{Binding YawAngle0, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" ValueAlign="right"
                                Unit="%" UnitWidthGroup="unitWidth"/>
                        </Grid>
                        <Grid>
                            <customControls:VectoParameterControl
                                Caption="Yaw angle 3" CaptionWidthGroup="lblGWidth"
                                Value="{Binding YawAngle3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" ValueAlign="right"
                                Unit="%" UnitWidthGroup="unitWidth"/>
                        </Grid>
                        <Grid>
                            <customControls:VectoParameterControl
                                Caption="Yaw angle 6" CaptionWidthGroup="lblGWidth"
                                Value="{Binding YawAngle6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" ValueAlign="right"
                                Unit="%" UnitWidthGroup="unitWidth"/>
                        </Grid>
                        <Grid>
                            <customControls:VectoParameterControl
                                Caption="Yaw angle 9" CaptionWidthGroup="lblGWidth"
                                Value="{Binding YawAngle9, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat=N2}" ValueAlign="right"
                                Unit="%" UnitWidthGroup="unitWidth"/>
                        </Grid>
                        </StackPanel>-->

                </StackPanel>
            </StackPanel>
        </GroupBox>
        <!--Width="560" Height="200"-->
        <GroupBox Header="Masses" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">

                    <Grid>
                        <customControls:VectoParameterControl
                            Caption="Corrected mass in running order" CaptionWidthGroup="lblGWidth"
                            Value="{Binding MassInRunningOrder, Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsKilos|int, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="kg" UnitWidthGroup="unitWidth"/>
                    </Grid>

                    <Grid>
                        <customControls:VectoParameterControl
                            Caption="TPMLM Trailer" CaptionWidthGroup="lblGWidth"
                            Value="{Binding TPLMTotalTrailer, Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsKilos|int, NotifyOnValidationError=True}" ValueAlign="right"
                            Unit="kg" UnitWidthGroup="unitWidth"/>
                    </Grid>

                    <Grid>
                        <customControls:VectoParameterControl
                            Caption="TPMLM Axle Assembly" CaptionWidthGroup="lblGWidth"
                            Visibility="{Binding TPMLMAxleAssemblyVisibility, Converter={StaticResource BoolToVisibilityConverter}}"
                            Value="{Binding TPLMAxleAssembly, NotifyOnValidationError=True, Converter={converter:SIValueConverter}, 
                                ConverterParameter=AsKilos|int}" ValueAlign="right"
                            Unit="kg" UnitWidthGroup="unitWidth"/>
                    </Grid>


                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Axle and Tyre Features" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5" HorizontalContentAlignment="Stretch">
            <StackPanel Orientation="Vertical" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                    <TextBlock Margin="5" HorizontalAlignment="Center" >
                        Select Number of Axles
                        <TextBlock.Style>
                            <Style>
                                <Setter Property="TextBlock.Visibility" Value="Collapsed"></Setter>
                                <Style.Triggers>
                                    <DataTrigger  
                                        Binding="{Binding ElementName=NumberOfAxles, Path=SelectedIndex, UpdateSourceTrigger=PropertyChanged}" Value="-1">
                                        <Setter Property="TextBlock.Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!--#region Axle1 -->
                    <Grid Margin="5">
                        <Grid.Style>
                            <Style>
                                <Setter Property="Grid.Visibility" Value="Collapsed"></Setter>
                                <Style.Triggers>

                                    <DataTrigger  
                                        Binding="{Binding ElementName=NumberOfAxles, Path=SelectedItem.Value}" Value="1">
                                        <Setter Property="Grid.Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                    <DataTrigger  
                                        Binding="{Binding ElementName=NumberOfAxles, Path=SelectedItem.Value}" Value="2">
                                        <Setter Property="Grid.Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                    <DataTrigger  
                                        Binding="{Binding ElementName=NumberOfAxles, Path=SelectedItem.Value}" Value="3">
                                        <Setter Property="Grid.Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <GroupBox Grid.Column="0" Header="Axle 1 - Tyre XML" HorizontalAlignment="Stretch" >
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock =" Right" Name="UploadFirstAxleButton" Grid.Column="3" Content="..." HorizontalAlignment="Right" Width="30" Margin="5,0,0,0"
                                            Command="{Binding SelectAxleXmlCommand}"
                                            CommandParameter="0"/>
                                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Axles[0].TyreInfo, TargetNullValue='Select tyre xml'}" Margin="5"/>
                                        <TextBox HorizontalAlignment="Stretch" IsReadOnly="True" DockPanel.Dock="Left"
                                             Text="{Binding Axles[0].TyreXmlPath}" Visibility="{Binding Axles[0].TyreXmlPath, Converter={converter:NullToVisibilityConverter}}" Name="FilePath1" TextChanged="ScrollToEnd" IsReadOnlyCaretVisible="True">
                                            <Validation.ErrorTemplate>
                                                <ControlTemplate>
                                                    <DockPanel>
                                                        <TextBlock Foreground="Red" DockPanel.Dock="Top" Text="{Binding ErrorContent}" />
                                                        <AdornedElementPlaceholder/>
                                                    </DockPanel>
                                                </ControlTemplate>
                                            </Validation.ErrorTemplate>
                                            <TextBox.Style>
                                                <Style>
                                                    <Style.Triggers>
                                                        <Trigger Property="Validation.HasError" Value="true">
                                                            <Setter Property="Border.BorderBrush" Value="Red"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                                        <TextBlock Grid.Column="5" Text="Twin tyres" Margin="5,0,5,0"/>
                                        <CheckBox Grid.Column="6" IsChecked="{Binding Axles[0].TwinTyres}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                                        <TextBlock Grid.Column="7" Text="Liftable" Margin="5,0,5,0"/>
                                        <CheckBox Grid.Column="8" IsChecked="{Binding Axles[0].Liftable}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
                                        <TextBlock Grid.Column="9" Text="Steered" Margin="5,0,5,0"/>
                                        <CheckBox Grid.Column="10" IsChecked="{Binding Axles[0].Steered}"  Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                    <!--#endregion-->

                    <!--#region Axle2 -->
                    <Grid Margin="5">
                        <Grid.Style>
                            <Style>
                                <Setter Property="Grid.Visibility" Value="Collapsed"></Setter>
                                <Style.Triggers>
                                    <DataTrigger  
                                        Binding="{Binding ElementName=NumberOfAxles, Path=SelectedItem.Value}" Value="2">
                                        <Setter Property="Grid.Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                    <DataTrigger  
                                        Binding="{Binding ElementName=NumberOfAxles, Path=SelectedItem.Value}" Value="3">
                                        <Setter Property="Grid.Visibility" Value="Visible"></Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <GroupBox Grid.Column="0" Header="Axle 2 - Tyre XML" HorizontalAlignment="Stretch" >
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock =" Right" Name="UploadSecondAxleButton" Grid.Column="3" Content="..." HorizontalAlignment="Right" Width="30" Margin="5,0,0,0"
                                            Command="{Binding SelectAxleXmlCommand}"
                                            CommandParameter="1"/>
                                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                                        <TextBlock Text="{Binding Axles[1].TyreInfo, TargetNullValue='Select tyre xml'}" Margin="5"/>
                                        <TextBox HorizontalAlignment="Stretch" IsReadOnly="True" DockPanel.Dock="Left"
