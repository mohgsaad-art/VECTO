<UserControl x:Class="VECTOTrailer.Views.ComponentViews.Declaration.CompleteTrailerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VECTOTrailer.Views.ComponentViews.Declaration"
             xmlns:interfaces="clr-namespace:VECTOTrailer.ViewModel.Interfaces"
             xmlns:customControls="clr-namespace:VECTOTrailer.Views.CustomControls"
             xmlns:helper="clr-namespace:VECTOTrailer.Helper"
             xmlns:converter="clr-namespace:VECTOTrailer.Helper.Converter"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:validation="clr-namespace:VECTOTrailer.Helper.Validation"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="500">

    <d:PrimaryVehicleBusView.DataContext>
        <x:Type Type="interfaces:ICompleteTrailerViewModel" />
    </d:PrimaryVehicleBusView.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10" />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>
            <RowDefinition Height="10" />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <GroupBox Header="Documentation" Grid.Row="1" Grid.Column="1" Width="350" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <StackPanel Orientation="Vertical" Width="300" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Manufacturer" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Manufacturer Address" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding ManufacturerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Commertial Name" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="VIN" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding VIN, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Date" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Legislative Class" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedLegislativeClasses}"
                                  SelectedValue="{Binding LegislativeClass, Mode=TwoWay ,ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  Text="Select..."/>
                    </Grid>

                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Dimensions" Grid.Row="2" Grid.Column="1" Width="350" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <StackPanel Orientation="Vertical" Width="300" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="External length of the body" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding ExternalLengthOfTheBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="External width of the body" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding ExternalWidthOfTheBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="External height of the body" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding ExternalHeightOfTheBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Total height of the trailer" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding TotalHeightOfTheTrailer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PositionXFirstAxle" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding PositionXFirstAxle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="PositionXLastAxle" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding PositionXLastAxle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Internal height of the body" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding InternalHeightOfTheBody, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Cargo Volume" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding CargoVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Classification" Grid.Row="1" Grid.Column="2" Width="350" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <StackPanel Orientation="Vertical" Width="300" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Number of Axles" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding NumberOfAxles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Trailer Type" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedTrailerTypes}"
                                  SelectedValue="{Binding TrailerType, Mode=TwoWay ,ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  Text="Select..."/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Body Code" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedBodyCodes}"
                                  SelectedValue="{Binding BodyCode, Mode=TwoWay ,ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  Text="Select..."/>
                    </Grid>

                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Standard aero feature technologies" Grid.Row="2" Grid.Column="2" Width="350" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <StackPanel Orientation="Vertical" Width="300" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Selection 1" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" 
                                  Margin="20,0,0,0"
                                  ItemsSource="{Binding AllowedTechnologies}"
                                  SelectedValue="{Binding Technologies, Mode=TwoWay ,ValidatesOnDataErrors=True, NotifyOnValidationError=True, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  IsEditable="True"
                                  IsReadOnly="True"
                                  Text="Select..."/>
                    </Grid>


                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Masses" Grid.Row="1" Grid.Column="3" Width="350" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <StackPanel Orientation="Vertical" Width="300" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Curb Mass Trailer" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding CurbMassTrailer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TPLM Total Trailer" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding TPLMTotalTrailer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>

                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="TPLM Axle Assembly" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding TPLMAxleAssembly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Axle and Tyre Features" Grid.Row="2" Grid.Column="3" Width="350" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
            <StackPanel Orientation="Vertical" Width="300" HorizontalAlignment="Left" Grid.IsSharedSizeScope="True" VerticalAlignment="Top">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Top" Grid.IsSharedSizeScope="True">
                
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="vehicleLbl"/>
                            <ColumnDefinition />
                            <ColumnDefinition SharedSizeGroup="unitWidth"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Tyre XML 1" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Margin="20,0,0,0" 
                                 Text="{Binding Manufacturer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True, NotifyOnValidationError=True}"/>
                    </Grid>


                </StackPanel>
            </StackPanel>
        </GroupBox>


    </Grid>
</UserControl>
