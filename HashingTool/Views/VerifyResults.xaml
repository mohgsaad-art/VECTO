						<Label Grid.Row="0" Grid.Column="0" Content="Creation Date:" />
						<TextBox Grid.Row="0" Grid.Column="1" Text="{helper:CultureAwareBinding Path=Date, Mode=OneWay, StringFormat='g'}"
