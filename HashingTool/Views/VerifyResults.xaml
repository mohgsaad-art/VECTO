						<Label Grid.Row="1" Grid.Column="0" Content="Canonicalization methods:" />
						<TextBox Grid.Row="1" Grid.Column="1"
								Text="{Binding CanonicalizationMethods, Mode=OneWay , Converter={StaticResource CollectionConverter}}"
